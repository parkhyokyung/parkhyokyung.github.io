---
layout: base.njk
---
<main class="article">
  <header class="head wrap">
    <h1>{{ title }}</h1>
    {% if work %}<p class="work">{{ work }}</p>{% endif %}
  </header>

  {% if image %}
  <figure class="cover wrap-wide">
    <img src="{{ image }}" alt="{{ image_alt or '' }}">
    {% if caption %}<figcaption>{{ caption }}</figcaption>{% endif %}
  </figure>
  {% endif %}

  <div class="wrap">
    <div class="prose">
{{ content | safe }}
    </div>

    <div class="endnote">
      <p class="meta"><span>{{ category | catLabel }}</span><time datetime="{{ page.date | iso }}">{{ page.date | dot }}</time>{% if source %}<span>{{ source }}</span>{% endif %}{% if seen and category != "programme" %}<span>관람 {{ seen | dot }}</span>{% endif %}</p>
      {% if link %}<p class="endlink"><a class="text-btn" href="{{ link }}" target="_blank" rel="noopener">원문 보기 ↗</a></p>{% endif %}
    </div>

    <p class="back"><a href="/writing/">← 글 목록</a></p>
  </div>
</main>
