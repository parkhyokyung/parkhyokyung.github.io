---
layout: base.njk
---
<main class="article">
  <div class="wrap">
    <header class="head">
      <p class="meta"><time datetime="{{ page.date | iso }}">{{ page.date | dot }}</time><span class="cat">{{ category | catLabel }}</span>{% if source %}<span>{{ source }}</span>{% endif %}</p>
      <h1>{{ title }}</h1>
      {% if work %}<p class="work">{{ work }}</p>{% endif %}
    </header>

    {% if image %}
    <figure class="plate">
      <img src="{{ image }}" alt="{{ image_alt or '' }}">
      {% if caption %}<figcaption>{{ caption }}</figcaption>{% endif %}
    </figure>
    {% endif %}

    <div class="prose">
{{ content | safe }}
    </div>

    <footer class="endnote">
      <p>{% if seen %}관람 {{ seen | dot }} · {% endif %}작성 {{ page.date | dot }}</p>
      {% if info %}<div class="info">{{ info | nl2br | safe }}</div>{% endif %}
      {% if link %}<p><a class="text-link" href="{{ link }}" target="_blank" rel="noopener">원문 보기{% if source %} · {{ source }}{% endif %} ↗</a></p>{% endif %}
    </footer>

    <a class="back" href="/#writing">← 글 목록</a>
  </div>
</main>
