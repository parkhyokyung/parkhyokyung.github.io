---
layout: base.njk
---
<main class="article">
  <header class="head wrap">
    <p class="meta center"><span>{{ category | catLabel }}</span><time datetime="{{ page.date | iso }}">{{ page.date | dot }}</time>{% if source %}<span>{{ source }}</span>{% endif %}</p>
    <h1>{{ title }}</h1>
    {% if work %}<p class="work">{{ work }}</p>{% endif %}
  </header>

  {% if image %}
  <figure class="cover wrap-wide">
    <img src="{{ image }}" alt="{{ image_alt or '' }}">
    {% if caption %}<figcaption>{{ caption }}</figcaption>{% endif %}
  </figure>
  {% endif %}

  <div class="wrap">
    <div class="prose">
{{ content | safe }}
    </div>

    <div class="endnote">
      <p>{% if seen %}관람 {{ seen | dot }} · {% endif %}작성 {{ page.date | dot }}</p>
      {% if info %}<p>{{ info | nl2br | safe }}</p>{% endif %}
      {% if link %}<p><a class="text-btn" href="{{ link }}" target="_blank" rel="noopener">원문 보기{% if source %} · {{ source }}{% endif %} ↗</a></p>{% endif %}
    </div>

    <p class="back"><a href="/#writing">← 글 목록</a></p>
  </div>
</main>
