---
layout: base.njk
---
<main class="article">
  <div class="wrap">
    <a class="back" href="/#writing">← Writing</a>

    <header class="head">
      <p class="kind">{{ categoryLabel[category] or "Writing" }}</p>
      <h1>{{ title }}</h1>
      {% if work %}<p class="work">{{ work }}</p>{% endif %}
      <p class="byline">박효경{% if source %}<span>{{ source }}</span>{% endif %}</p>
    </header>

    {% if image %}
    <figure class="plate">
      <img src="{{ image }}" alt="{{ image_alt or '' }}">
      {% if caption %}<figcaption>{{ caption }}</figcaption>{% endif %}
    </figure>
    {% endif %}

    <div class="prose">
{{ content | safe }}
    </div>

    <p class="dates">{% if seen %}관람 {{ seen | dot }}{% endif %}{% if seen %} · {% endif %}작성 {{ page.date | dot }}</p>

    {% if info %}<div class="info">{{ info | nl2br | safe }}</div>{% endif %}

    {% if link %}<p class="orig"><a href="{{ link }}" target="_blank" rel="noopener">원문 보기{% if source %} · {{ source }}{% endif %} ↗</a></p>{% endif %}
  </div>
</main>
