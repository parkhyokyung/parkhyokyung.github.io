---
layout: base.njk
---
<main class="article">
  <header class="head wrap">
    <p class="cat">{{ category | catLabel }}</p>
    <h1>{{ title }}</h1>
    <p class="artmeta"><time datetime="{{ page.date | iso }}">{{ page.date | dot }}</time>{% if work %} {{ work }}{% endif %}{% if source %} · {{ source }}{% endif %}</p>
  </header>

  {% if image %}
  <figure class="cover wrap-wide">
    <img src="{{ image }}" alt="{{ image_alt or '' }}">
    {% if caption %}<figcaption>{{ caption }}</figcaption>{% endif %}
  </figure>
  {% endif %}

  <div class="wrap">
    <div class="prose">
{{ content | safe }}
    </div>

    {% if link %}
    <p class="endlink"><a class="text-btn" href="{{ link }}" target="_blank" rel="noopener">원문 보기 ↗</a></p>
    {% endif %}

    <p class="back"><a href="/writing/">← 글 목록</a></p>
  </div>
</main>
