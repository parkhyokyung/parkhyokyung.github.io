<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if title %}{{ title }} · {% endif %}박효경 Park Hyokyung</title>
<meta name="description" content="{{ description or ((work + ' · 박효경') if work) or '극장 다니는 사람. 연극 비평가이자 드라마터그. 성북동비둘기 상주 드라마터그, 공연평론웹진 사이:비평 필진.' }}">
<meta property="og:title" content="{% if title %}{{ title }} · {% endif %}박효경 Park Hyokyung">
<meta property="og:description" content="{{ description or ((work + ' · 박효경') if work) or '극장 다니는 사람. 연극 비평가이자 드라마터그. 성북동비둘기 상주 드라마터그, 공연평론웹진 사이:비평 필진.' }}">
<meta property="og:image" content="{{ site.url }}{{ image or '/assets/images/stage.jpg' }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#121210" media="(prefers-color-scheme: dark)">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="stylesheet" href="/assets/style.css?v={{ build }}">
{%- if page.url == '/' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "박효경",
  "alternateName": ["Park Hyokyung", "박효경 Park Hyokyung"],
  "jobTitle": ["연극 비평가", "연극 평론가", "드라마터그"],
  "description": "연극 비평가이자 드라마터그. 성북동비둘기 상주 드라마터그, 공연평론웹진 사이:비평 필진.",
  "url": "{{ site.url }}/",
  "image": "{{ site.url }}/icon-512.png",
  "email": "hyokyung.scene@gmail.com",
  "knowsLanguage": ["ko", "en"],
  "nationality": "KR",
  "worksFor": { "@type": "Organization", "name": "극단 성북동비둘기", "url": "https://www.beedoolkeetheatre.com/" },
  "alumniOf": { "@type": "CollegeOrUniversity", "name": "서울대학교 대학원" },
  "sameAs": ["https://www.instagram.com/1evening/"]
}
</script>
{%- endif %}
</head>
<body data-cite-url="{{ site.url }}{{ page.url }}"{% if layout == 'post.njk' %} data-cite-title="{{ title }}"{% endif %}{% if page.url == '/cv/' %} data-cite-lang="en"{% endif %}>
<header class="site-head">
  <div class="wrap-wide">
    <a class="site-name" href="/">Park Hyokyung</a>
    <nav class="site-nav" aria-label="섹션">
      <a href="/writing/">Writing</a>
      <a href="/#dramaturg">Dramaturg</a>
      <a href="/#management">Management</a>
      <a href="/#about">About</a>
      <a href="/cv/" lang="en"{% if page.url == '/cv/' %} aria-current="page"{% endif %}>CV</a>
    </nav>
    <div class="head-tools">
      <button class="icon-btn" type="button" id="btn-search" aria-expanded="false" aria-controls="panel" aria-label="검색">
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="9" cy="9" r="5.5"/><path d="M13.2 13.2 17 17"/></svg>
      </button>
      <button class="icon-btn only-narrow" type="button" id="btn-menu" aria-expanded="false" aria-controls="panel" aria-label="메뉴">
        <svg viewBox="0 0 20 20" aria-hidden="true" class="i-open"><path d="M3 6h14M3 10h14M3 14h14"/></svg>
        <svg viewBox="0 0 20 20" aria-hidden="true" class="i-close"><path d="M5 5l10 10M15 5L5 15"/></svg>
      </button>
    </div>
  </div>
  <div class="panel" id="panel" hidden data-mode="menu">
    <div class="wrap-wide">
      <div class="panel-search">
      <label class="search-field">
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="9" cy="9" r="5.5"/><path d="M13.2 13.2 17 17"/></svg>
        <input type="search" id="q" placeholder="글 제목으로 검색" autocomplete="off" aria-label="글 검색">
      </label>
      <ul class="results" id="results" hidden></ul>
      <p class="no-hit" id="no-hit" hidden>찾는 글이 없습니다.</p>
      </div>
      <nav class="panel-nav" aria-label="메뉴">
        <a href="/writing/">Writing</a>
        <a href="/#dramaturg">Dramaturg</a>
        <a href="/#management">Management</a>
        <a href="/#about">About</a>
        <a href="/cv/" lang="en"{% if page.url == '/cv/' %} aria-current="page"{% endif %}>CV</a>
      </nav>
    </div>
  </div>
</header>

<script id="search-data" type="application/json">[
{%- for item in collections.writing %}{% if not loop.first %},{% endif %}{"t":{{ item.data.title | dump | safe }},"u":{{ (item.url if item.data.hasPage else (item.data.link or "/writing/")) | dump | safe }},"c":{{ (item.data.category | catLabel) | dump | safe }},"w":{{ (item.data.work or "") | dump | safe }},"y":"{{ item.date | year }}"}{% endfor %}
]</script>

{{ content | safe }}

<footer class="site-foot">
  <div class="wrap-wide">
    <div class="foot-top">
      <div class="foot-me">
        <p class="fname">박효경 Park Hyokyung</p>
        <p class="flinks"><a href="mailto:hyokyung.scene@gmail.com">hyokyung.scene@gmail.com</a></p>
      </div>
    </div>
    <p class="foot-legal">© {{ "now" | year }} Park Hyokyung</p>
  </div>
</footer>

<script>
/* 복사할 때 출처 붙이기. 짧은 조각(이메일 등)과 입력칸은 건드리지 않는다 */
(function(){
  var b=document.body, url=b.getAttribute('data-cite-url')||location.href;
  var title=b.getAttribute('data-cite-title'), en=b.getAttribute('data-cite-lang')==='en';
  var line = en ? 'Source: Park Hyokyung, '+url
    : '출처: 박효경'+(title ? ', ｢'+title+'｣' : ' Park Hyokyung')+', '+url;
  document.addEventListener('copy', function(e){
    var t=e.target, tag=t && t.nodeName;
    if(tag==='INPUT'||tag==='TEXTAREA') return;
    var sel=window.getSelection(); if(!sel||sel.isCollapsed) return;
    var text=sel.toString(); if(text.trim().length<20 || !e.clipboardData) return;
    var box=document.createElement('div');
    for(var i=0;i<sel.rangeCount;i++) box.appendChild(sel.getRangeAt(i).cloneContents());
    var esc=function(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;')};
    e.clipboardData.setData('text/plain', text+'\n\n'+line);
    e.clipboardData.setData('text/html', box.innerHTML+'<p><br>'+esc(line).replace(esc(url),'<a href="'+url+'">'+esc(url)+'</a>')+'</p>');
    e.preventDefault();
  });
})();
</script>

<script>
(function(){
  /* 글 분류 버튼 (전체 글 페이지) */
  var pills=document.querySelectorAll('.pill');
  if(pills.length){
    var entries=document.querySelectorAll('.entry'), groups=document.querySelectorAll('[data-group]');
    var feat=document.querySelector('.featured'), only=document.querySelectorAll('[data-only]');
    var apply=function(f){
      pills.forEach(function(p){p.setAttribute('aria-pressed', p.getAttribute('data-filter')===f ? 'true':'false')});
      entries.forEach(function(e){e.hidden=!(f==='all'||e.getAttribute('data-cat')===f)});
      groups.forEach(function(g){g.hidden=!g.querySelector('.entry:not([hidden])')});
      if(feat) feat.hidden=!(f==='all'||feat.getAttribute('data-cat')===f);
      only.forEach(function(el){el.hidden=el.getAttribute('data-only')!==f});
      try{history.replaceState(null,'', f==='all' ? location.pathname : '#'+f)}catch(e){}
    };
    pills.forEach(function(p){p.addEventListener('click', function(){apply(p.getAttribute('data-filter'))})});
    var h=location.hash.replace('#','');
    apply(['criticism','brief','programme','academic','roundtable'].indexOf(h)>-1 ? h : 'all');
  }

  /* 펼침 메뉴와 검색 */
  var panel=document.getElementById('panel'), q=document.getElementById('q');
  var bs=document.getElementById('btn-search'), bm=document.getElementById('btn-menu');
  var out=document.getElementById('results'), nohit=document.getElementById('no-hit');
  if(!panel) return;
  var data=[];
  try{data=JSON.parse(document.getElementById('search-data').textContent)}catch(e){}

  function render(term){
    if(!out) return;
    term=(term||'').trim().toLowerCase();
    if(!term){ out.hidden=true; out.innerHTML=''; nohit.hidden=true; return; }
    var hits=data.filter(function(d){
      return (d.t+' '+d.w+' '+d.c+' '+d.y).toLowerCase().indexOf(term)>-1;
    }).slice(0,8);
    out.innerHTML=hits.map(function(d){
      var esc=function(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;')};
      return '<li><a href="'+esc(d.u)+'"><span class="r-meta">'+esc(d.y)+' · '+esc(d.c)+'</span><span class="r-title">'+esc(d.t)+'</span></a></li>';
    }).join('');
    out.hidden=hits.length===0;
    nohit.hidden=hits.length>0;
  }
  function setOpen(open, mode){
    panel.hidden=!open;
    if(open) panel.setAttribute('data-mode', mode);
    if(bs) bs.setAttribute('aria-expanded', (open && mode==='search')?'true':'false');
    if(bm) bm.setAttribute('aria-expanded', (open && mode==='menu')?'true':'false');
    if(open && mode==='search' && q) q.focus();
    if(!open){ if(q) q.value=''; render(''); }
  }
  function toggle(mode){
    var same = !panel.hidden && panel.getAttribute('data-mode')===mode;
    setOpen(!same, mode);
  }
  if(bs) bs.addEventListener('click', function(){ toggle('search') });
  if(bm) bm.addEventListener('click', function(){ toggle('menu') });
  if(q) q.addEventListener('input', function(){ render(q.value) });
  panel.addEventListener('click', function(e){ if(e.target.closest('a')) setOpen(false,'menu') });
  document.addEventListener('keydown', function(e){ if(e.key==='Escape' && !panel.hidden) setOpen(false,'menu') });
})();
</script>
</body>
</html>
