<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if title %}{{ title }} · {% endif %}박효경 Park Hyokyung</title>
<meta name="description" content="{{ description or ((work + ' · 박효경') if work) or '박효경. 연극비평가, 드라마터그. 극장 다니는 사람.' }}">
<meta property="og:title" content="{% if title %}{{ title }} · {% endif %}박효경 Park Hyokyung">
<meta property="og:description" content="{{ description or ((work + ' · 박효경') if work) or '박효경. 연극비평가, 드라마터그. 극장 다니는 사람.' }}">
<meta property="og:image" content="{{ site.url }}{{ image or '/assets/images/stage.jpg' }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#121211" media="(prefers-color-scheme: dark)">
<link rel="stylesheet" href="/assets/style.css">
</head>
<body>
<header class="site-head">
  <div class="wrap-wide">
    <a class="site-name" href="/">박효경 Park Hyokyung</a>
    <nav class="site-nav" aria-label="섹션">
      <a href="/#writing">Writing</a>
      <a href="/#dramaturg">Dramaturg</a>
      <a href="/#management">Management</a>
      <a href="/#about">About</a>
    </nav>
  </div>
</header>

{{ content | safe }}

<footer class="site-foot">
  <div class="wrap-wide">
    <div class="who">
      <strong>박효경</strong>
      <p>극장 다니는 사람. 연극비평가이자 드라마터그. 극단 성북동비둘기 상주 드라마터그, 공연예술비평 웹진 사이:비평 창간인.</p>
    </div>
    <div>
      <h4>Site</h4>
      <ul>
        <li><a href="/#writing">Writing</a></li>
        <li><a href="/#dramaturg">Dramaturg</a></li>
        <li><a href="/#management">Management</a></li>
        <li><a href="/#about">About</a></li>
      </ul>
    </div>
    <div>
      <h4>Elsewhere</h4>
      <ul>
        <li><a href="https://saicriticism.com" target="_blank" rel="noopener">사이:비평 ↗</a></li>
        <li><a href="https://www.beedoolkeetheatre.com" target="_blank" rel="noopener">성북동비둘기 ↗</a></li>
        <li><a href="mailto:hyokyung.scene@gmail.com">이메일</a></li>
      </ul>
    </div>
    <p class="legal">© {{ "now" | year }} 박효경</p>
  </div>
</footer>

<script>
(function(){
  document.querySelectorAll('[data-copy]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var el=document.getElementById(btn.getAttribute('data-copy')), text=el.textContent.trim(), label=btn.textContent;
      function done(){btn.textContent='복사됨';setTimeout(function(){btn.textContent=label},1600)}
      function fallback(){var r=document.createRange();r.selectNodeContents(el);var s=getSelection();s.removeAllRanges();s.addRange(r);btn.textContent='선택됨'}
      try{navigator.clipboard.writeText(text).then(done,fallback)}catch(e){fallback()}
    });
  });
  var chips=document.querySelectorAll('.chip');
  if(!chips.length) return;
  var items=[].slice.call(document.querySelectorAll('#writing .list .item'));
  var only=document.querySelectorAll('#writing [data-only]');
  var LIMIT=6, expanded=false, current='all';
  function apply(f){
    current=f;
    chips.forEach(function(o){o.setAttribute('aria-pressed', o.getAttribute('data-filter')===f ? 'true':'false')});
    var shown=0;
    items.forEach(function(it){
      var match=(f==='all'||it.getAttribute('data-cat')===f);
      if(match && f==='all' && !expanded && shown>=LIMIT) match=false;
      it.hidden=!match; if(match) shown++;
    });
    only.forEach(function(el){
      var want=el.getAttribute('data-only');
      el.hidden = want==='all' ? (f!=='all' || expanded || items.length<=LIMIT) : want!==f;
    });
  }
  chips.forEach(function(c){c.addEventListener('click', function(){apply(c.getAttribute('data-filter'))})});
  var more=document.getElementById('show-all');
  if(more) more.addEventListener('click', function(){expanded=true; apply('all')});
  apply('all');
})();
</script>
</body>
</html>
