<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if title %}{{ title }} · {% endif %}박효경 Park Hyokyung</title>
<meta name="description" content="{{ description or ((work + ' · 박효경') if work) or '박효경. 연극비평가, 드라마터그. 극장 다니는 사람.' }}">
<meta property="og:title" content="{% if title %}{{ title }} · {% endif %}박효경 Park Hyokyung">
<meta property="og:description" content="{{ description or ((work + ' · 박효경') if work) or '박효경. 연극비평가, 드라마터그. 극장 다니는 사람.' }}">
<meta property="og:image" content="{{ site.url }}{{ image or '/assets/images/stage.jpg' }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#121211" media="(prefers-color-scheme: dark)">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;1,400&family=Outfit:wght@300..700&display=swap">
<link rel="stylesheet" href="/assets/style.css?v={{ build }}">
</head>
<body>
<header class="site-head">
  <div class="wrap-wide">
    <a class="site-name" href="/">박효경 Park Hyokyung</a>
    <nav class="site-nav" aria-label="섹션">
      <a href="/writing/">Writing</a>
      <a href="/#dramaturg">Dramaturg</a>
      <a href="/#management">Management</a>
      <a href="/#about">About</a>
    </nav>
  </div>
</header>

{{ content | safe }}

<footer class="site-foot">
  <div class="wrap-wide">© {{ "now" | year }} 박효경</div>
</footer>

<script>
(function(){
  var pills=document.querySelectorAll('.pill');
  if(!pills.length) return;
  var entries=document.querySelectorAll('.entry'), groups=document.querySelectorAll('[data-group]');
  var featured=document.querySelector('.featured'), only=document.querySelectorAll('[data-only]');
  function apply(f){
    pills.forEach(function(p){p.setAttribute('aria-pressed', p.getAttribute('data-filter')===f ? 'true':'false')});
    entries.forEach(function(e){e.hidden=!(f==='all'||e.getAttribute('data-cat')===f)});
    groups.forEach(function(g){g.hidden=!g.querySelector('.entry:not([hidden])')});
    if(featured) featured.hidden=!(f==='all'||featured.getAttribute('data-cat')===f);
    only.forEach(function(el){el.hidden=el.getAttribute('data-only')!==f});
    try{history.replaceState(null,'', f==='all' ? location.pathname : '#'+f)}catch(e){}
  }
  pills.forEach(function(p){p.addEventListener('click', function(){apply(p.getAttribute('data-filter'))})});
  var h=location.hash.replace('#','');
  apply(['criticism','programme','academic'].indexOf(h)>-1 ? h : 'all');
})();
</script>
</body>
</html>
